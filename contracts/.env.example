# Copy to .env and fill in. NEVER commit .env or any real private key.

# Only needed for the public testnet deployment
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Address that will receive ORACLE_ROLE (the wallet the oracle service uses).
# If empty, deploy.ts uses the second local Hardhat account.
ORACLE_ADDRESS=

# Gas reporting: `npm run gas` turns it on. Set a file name to save the table.
GAS_REPORT_FILE=
