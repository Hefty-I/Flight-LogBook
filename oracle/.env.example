# Copy to .env. NEVER commit .env.

# Which deployment to use: shared/deployments/<NETWORK>.json
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545

# Wallet that holds ORACLE_ROLE. For the local demo, paste the private key of
# Hardhat account #1 from the `npx hardhat node` output. Never use a real key here.
ORACLE_PRIVATE_KEY=

# "fixture" replays recorded data from fixtures/opensky/, "live" calls the OpenSky API
OPENSKY_MODE=fixture
# Live mode only: create an API client on your OpenSky account page (OAuth2 client credentials)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: pin evidence files to IPFS with Pinata (otherwise kept in state/evidence/)
PINATA_JWT=

# Matching tolerance for take-off and landing times, in minutes
MATCH_TOLERANCE_MIN=30
# Live mode: wait this long after landing (OpenSky processes flights overnight)
LIVE_DELAY_HOURS=24
POLL_INTERVAL_MS=5000
